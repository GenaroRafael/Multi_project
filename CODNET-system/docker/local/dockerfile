FROM apache/airflow:2.10.2-python3.11

WORKDIR /opt/airflow

USER root

# Paquetes del sistema necesarios
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    git \
 && rm -rf /var/lib/apt/lists/*

USER airflow

# Copiamos los archivos de dependencias
COPY pyproject.toml .
COPY poetry.lock* .

# Definir constraints de Airflow
ARG AIRFLOW_VERSION=2.10.2
ARG PYTHON_VERSION=3.11
ARG CONSTRAINT_URL="https://raw.githubusercontent.com/apache/airflow/constraints-${AIRFLOW_VERSION}/constraints-${PYTHON_VERSION}.txt"

# Instalamos Poetry
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir poetry

# Instalamos dependencias con Poetry, respetando constraints de Airflow
RUN poetry config virtualenvs.create false \
 && poetry install --no-root --no-interaction --no-ansi -c ${CONSTRAINT_URL}

# Copiamos el resto del proyecto (dags, plugins, etc.)
COPY . .
